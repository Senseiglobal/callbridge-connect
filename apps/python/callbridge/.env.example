# Safe default: no real calls.
CALLE_DRY_RUN=true
CALLE_API_KEY=

# local or firestore
STORAGE_BACKEND=local
GOOGLE_CLOUD_PROJECT=

# A separate bearer token is required to enable Aura's creation endpoint.
AURA_INTEGRATION_TOKEN=

# Private operator console; required for live calls. Never use the CALL-E key here.
CALLBRIDGE_ADMIN_TOKEN=
CALLBRIDGE_ALLOWED_PHONES=
CALLBRIDGE_PUBLIC_DEMO=false
# Values in this example are documentation; app.py reads actual process environment variables.
